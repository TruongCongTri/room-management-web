# Copy to .env.local and fill in to use a real backend. Leave unset to use the built-in mock API.

# Server-side reads (pages, during build and revalidation). Absolute URL, no trailing slash.
API_BASE_URL=

# Browser reads and form posts (contact, newsletter). Defaults to the mock at /api.
# Usually the same as API_BASE_URL; the backend must allow CORS from this site.
NEXT_PUBLIC_API_BASE_URL=

# Shared secret for POST /api/revalidate (lets the backend clear a cached resource right away).
REVALIDATE_SECRET=

# Public Listing API (docs/04-Swagger-API.md, tag "Public Listing"): live room types, rooms,
# availability, prices and equipment for the rooms pages. Server-side only, no token needed.
# Leave unset to use the built-in mock listing.
# Calls are made in the page's language (Accept-Language vi-VN or en-US).
LISTING_API_BASE_URL=
LISTING_BUILDING_SLUG=
